
‚.ú-# =============================================================================
# EXISTING ENTITIES (PRESERVED EXACTLY AS-IS)
# =============================================================================

type Node @entity(immutable: false) {
  id: Bytes!
  nodeId: BigInt!
  owner: Bytes!
  timestamp: BigInt!
}

type Reward @entity(immutable: false) {
  id: Bytes!
  nodeId: BigInt!
  owner: Bytes!
  amount: BigInt!
  timestamp: BigInt!
}

type Stake @entity(immutable: false) {
  id: Bytes!
  nodeId: BigInt!
  staker: Bytes!
  amount: BigInt!
  timestamp: BigInt!
}

type Uptime @entity(immutable: false) {
  id: Bytes!
  nodeId: BigInt!
  minutesUp: BigInt!
  timestamp: BigInt!
}

# =============================================================================
# NEW ENTITIES FOR STAKING POOL CONTRACT
# =============================================================================

type PoolStake @entity(immutable: false) {
  id: Bytes!                    # tx-hash-log-index
  user: Bytes!                  # address
  positionId: BigInt!
  tier: Int!                    # 0=BRONZE, 1=SILVER, 2=GOLD, 3=DIAMOND
  lockPeriod: Int!              # 0=NONE, 1=THIRTY, 2=NINETY, 3=YEAR
  amount: BigInt!               # ETH amount in wei
  shares: BigInt!               # Pool shares received
  timestamp: BigInt!
  blockNumber: BigInt!
  transactionHash: Bytes!
}

type StakeWithdrawal @entity(immutable: false) {
  id: Bytes!                    # tx-hash-log-index
  user: Bytes!
  positionId: BigInt!
  amount: BigInt!               # Amount withdrawn
  penalty: BigInt!              # Penalty applied
  timestamp: BigInt!
  blockNumber: BigInt!
  transactionHash: Bytes!
}

type RewardClaim @entity(immutable: false) {
  id: Bytes!                    # tx-hash-log-index
  user: Bytes!
  positionId: BigInt!
  rewardAmount: BigInt!         # DPN rewards claimed
  totalClaimed: BigInt!         # Total claimed by this position
  timestamp: BigInt!
  blockNumber: BigInt!
  transactionHash: Bytes!
}

type PoolConfig @entity(immutable: false) {
  id: Bytes!                    # tier as string
  tier: Int!                    # Pool tier number
  minStake: BigInt!             # Minimum ETH stake
  tierMultiplier: BigInt!       # Reward multiplier (basis points)
  baseRewardRate: BigInt!       # DPN per second
  timestamp: BigInt!
  blockNumber: BigInt!
  transactionHash: Bytes!
}

type GlobalStats @entity(immutable: false) {
  id: Bytes!                    # "global"
  totalValueLocked: BigInt!     # Total ETH across all pools
  totalRewardsDistributed: BigInt! # Total DPN distributed
  lastUpdated: BigInt!
  blockNumber: BigInt!
}

# =============================================================================
# NEW ENTITIES FOR NODE RIGHTS NFT CONTRACT
# =============================================================================

type NodeRights @entity(immutable: false) {
  id: Bytes!                    # tokenId
  tokenId: BigInt!
  owner: Bytes!                 # current owner
  nodeType: Int!                # 0=STORAGE, 1=COMPUTE, 2=BANDWIDTH
  stakedETH: BigInt!            # ETH staked
  stakedDPN: BigInt!            # DPN staked
  mintedAt: BigInt!
  blockNumber: BigInt!
  transactionHash: Bytes!
}

type NodeUpgrade @entity(immutable: false) {
  id: Bytes!                    # tx-hash-log-index
  tokenId: BigInt!
  additionalETH: BigInt!
  additionalDPN: BigInt!
  newPerformanceScore: BigInt!
  timestamp: BigInt!
  blockNumber: BigInt!
  transactionHash: Bytes!
}

type PerformanceUpdate @entity(immutable: false) {
  id: Bytes!                    # tx-hash-log-index
  tokenId: BigInt!
  newScore: BigInt!
  uptimeAdded: BigInt!          # Seconds added
  status: Int!                  # 0=ACTIVE, 1=SLASHED_MINOR, 2=SLASHED_MAJOR, 3=TERMINATED
  timestamp: BigInt!
  blockNumber: BigInt!
  transactionHash: Bytes!
}

type NodeSlashing @entity(immutable: false) {
  id: Bytes!                    # tx-hash-log-index
  tokenId: BigInt!
  newStatus: Int!               # Node status after slashing
  penaltyAmount: BigInt!        # DPN penalty
  reason: String!
  timestamp: BigInt!
  blockNumber: BigInt!
  transactionHash: Bytes!
}

type CrossChainBridge @entity(immutable: false) {
  id: Bytes!                    # tx-hash-log-index
  tokenId: BigInt!
  destinationChain: String!
  operator: Bytes!              # Who initiated bridge
  timestamp: BigInt!
  blockNumber: BigInt!
  transactionHash: Bytes!
}

type RewardDistribution @entity(immutable: false) {
  id: Bytes!                    # tx-hash-log-index
  tokenId: BigInt!
  rewardAmount: BigInt!
  performanceBonus: BigInt!
  timestamp: BigInt!
  blockNumber: BigInt!
  transactionHash: Bytes!
}

# =============================================================================
# NEW ENTITIES FOR DPN TOKEN CONTRACT
# =============================================================================

type TokenTransfer @entity(immutable: false) {
  id: Bytes!                    # tx-hash-log-index
  from: Bytes!
  to: Bytes!
  value: BigInt!
  timestamp: BigInt!
  blockNumber: BigInt!
  transactionHash: Bytes!
}

type TokenBalance @entity(immutable: false) {
  id: Bytes!                    # address
  holder: Bytes!
  balance: BigInt!
  lastUpdated: BigInt!
}

# =============================================================================
# NEW ENTITIES FOR NODE REGISTRY CONTRACT
# =============================================================================

type RegisteredNode @entity(immutable: false) {
  id: Bytes!                    # nodeId
  nodeId: BigInt!
  owner: Bytes!
  registeredAt: BigInt!
  blockNumber: BigInt!
  transactionHash: Bytes!
}

type NodeStatusChange @entity(immutable: false) {
  id: Bytes!                    # tx-hash-log-index
  nodeId: BigInt!
  newStatus: Int!
  timestamp: BigInt!
  blockNumber: BigInt!
  transactionHash: Bytes!
}
